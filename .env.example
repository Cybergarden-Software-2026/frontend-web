# Frontend API prefix. /api/v1 uses the Vite development proxy.
VITE_API_BASE_URL=/api/v1
# Published API port of the local backend Compose project (8001 with compose.vserver.yml).
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Optional local demo API only:
# SOURCE_FILE=/absolute/path/to/incidents.json
# ITSM_URL_TEMPLATE=https://your-itsm.example/incidents/{sysId}
# API_PORT=3001
