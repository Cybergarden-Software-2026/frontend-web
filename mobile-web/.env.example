# Same-origin API. In production proxy /api to the existing Rust API.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=https://cybergarden.sosmooth.ru
# Set /mobile/ to deploy separately under the existing HTTPS origin.
APP_BASE_PATH=/
# PUBLIC VAPID key, not a server/private credential.
VITE_FIREBASE_VAPID_KEY=
