# Separate PWA at https://your-host/mobile/. Build APP_BASE_PATH=/mobile/.
# Copy dist contents to /var/www/underctrl/mobile/ (including service-worker.js).
# Existing HTTPS vhost and /api proxy remain managed by the deployment owner.
location /mobile/ {
    root /var/www/underctrl;
    try_files $uri $uri/ /mobile/index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.firebaseinstallations.googleapis.com https://fcmregistrations.googleapis.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Permissions-Policy "camera=(self), microphone=()" always;
    add_header Cache-Control "no-cache";
}
# The service worker is scoped to /mobile/; do not grant root-wide scope.
# /api/ must proxy to the existing Rust API on the same origin.
